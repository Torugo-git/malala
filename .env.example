# PORTA DO SERVIDOR
PORT=3000

# MERCADO PAGO CREDENCIAIS
# Obtenha em: https://www.mercadopago.com.br/developers/panel/app
# Para ambiente de testes utilize as chaves que começam com "TEST-"
MERCADOPAGO_ACCESS_TOKEN=TEST-0000000000000000-000000-00000000000000000000000000000000-000000000
MERCADOPAGO_PUBLIC_KEY=TEST-00000000-0000-0000-0000-000000000000

# URL EXTERNA DO BACKEND NO RENDER (Para receber notificações de pagamento via Webhook)
# Exemplo: https://malala-backend-1.onrender.com
RENDER_EXTERNAL_URL=https://sua-api.onrender.com

# EMAILJS (Disparo de confirmação de pedido por e-mail)
EMAILJS_SERVICE_ID=service_fvb6yhg
EMAILJS_TEMPLATE_ID=template_n10dl83
EMAILJS_PUBLIC_KEY=vI8slPfRAcF3rOg0P
EMAILJS_PRIVATE_KEY=sua_private_key_do_emailjs

# FIREBASE SERVICE ACCOUNT (JSON EM STRING)
# Baixe a chave em: Firebase Console > Configurações do Projeto > Contas de Serviço > Gerar nova chave privada
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"malala-ca5f9","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"..."}

# FRETE / MELHOR ENVIO (Cotação em tempo real dos Correios PAC e SEDEX)
# Gere seu token em: https://melhorenvio.com.br/painel/gerenciar/tokens
# Enquanto não configurar o token, o sistema usa automaticamente a tabela de fallback configurável no Painel Admin.
MELHOR_ENVIO_TOKEN=
MELHOR_ENVIO_SANDBOX=false
ORIGIN_CEP=20040002
