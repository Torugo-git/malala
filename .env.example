# PORTA DO SERVIDOR
PORT=3000

# MERCADO PAGO CREDENCIAIS
# Obtenha em: https://www.mercadopago.com.br/developers/panel/app
# Para ambiente de testes utilize as chaves que começam com "TEST-"
MERCADOPAGO_ACCESS_TOKEN=TEST-0000000000000000-000000-00000000000000000000000000000000-000000000
MERCADOPAGO_PUBLIC_KEY=TEST-00000000-0000-0000-0000-000000000000

# URL DO SEU SERVIDOR PUBLICADO (Para receber notificações de pagamento via Webhook)
# Exemplo em desenvolvimento local usando ngrok: https://abcd-123.ngrok-free.app/api/payments/webhook
MERCADOPAGO_WEBHOOK_URL=https://sua-api.com/api/payments/webhook

# FIREBASE SERVICE ACCOUNT (JSON EM STRING)
# Baixe a chave em: Firebase Console > Configurações do Projeto > Contas de Serviço > Gerar nova chave privada
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"malala-ca5f9","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"..."}
