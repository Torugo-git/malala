rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Função que define quem é o dono (Admin)
    function isAdmin() {
      return request.auth != null && request.auth.token.email_verified == true && request.auth.token.email == 'malalastore.pedidos@gmail.com';
    }

    // Regras do Catálogo
    match /malala_store/catalog {
      allow read: if true; 
      allow write: if isAdmin();
    }

    // Regras de Configuração de Frete (lido pelo Backend Admin SDK, editado pelo Admin)
    match /malala_store/shipping {
      allow read, write: if isAdmin();
    }

    // Regras das Encomendas
    match /orders/{orderId} {
      allow create: if isAdmin();
      allow read: if isAdmin() || (request.auth != null && request.auth.token.email_verified == true && resource.data.payer.email == request.auth.token.email);
      allow update, delete: if isAdmin();
    }

    // Regras de Carrinhos Abandonados (somente Admin lê/gerencia; captura via Backend Admin SDK)
    match /abandoned_carts/{cartId} {
      allow read, write: if isAdmin();
    }

    // Trava anti-replay de pagamentos (somente Backend Admin SDK)
    match /processed_payments/{paymentId} {
      allow read, write: if false;
    }

    // Negação padrão
    match /{document=**} {
      allow read, write: if false;
    }
  }
}